# ============================================
# RECEITA JUSTA - Environment Variables
# ============================================
# Crie uma cópia como .env e preencha os valores
# NUNCA commite o .env real
# ============================================

# --- Banco de Dados ---
# PostgreSQL (Supabase, Neon, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Autenticação NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# gere com: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"

# --- AI Assistant (OpenRouter / OpenAI) ---
# OPENAI_API_KEY="sk-or-v1-..."
# OPENAI_API_URL="https://openrouter.ai/api/v1/chat/completions"
# AI_MODEL="openrouter/free"

# --- Mercado Pago ---
# MERCADO_PAGO_ACCESS_TOKEN="TEST-..."
# MERCADO_PAGO_WEBHOOK_SECRET="..."
# NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=""

# --- Stripe (opcional) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
